{
  "name": "@catalogo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "admin:promover": "tsx --env-file=.env scripts/promover-admin.ts",
    "teste:integracao": "tsx --env-file=.env scripts/teste-integracao.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@catalogo/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

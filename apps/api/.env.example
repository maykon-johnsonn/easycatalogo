PORT=3333
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Supabase (Settings > API Keys)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Storage S3-compatible
# Dev: Supabase Storage (Storage > S3 Configuration > New access key; região = região do projeto)
# Prod: MinIO na VPS (ex.: S3_ENDPOINT=https://s3.seudominio.com)
S3_ENDPOINT=https://seu-projeto.storage.supabase.co/storage/v1/s3
S3_REGION=sa-east-1
S3_ACCESS_KEY=seu_access_key
S3_SECRET_KEY=seu_secret_key
S3_BUCKET=catalogo-produtos
S3_PUBLIC_URL=https://seu-projeto.supabase.co/storage/v1/object/public/catalogo-produtos

PORT=3333
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Supabase (Settings > API Keys)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Storage de imagens
# supabase: Supabase Storage usando a SUPABASE_SECRET_KEY (dev, sem chaves extras)
# s3: MinIO ou outro S3-compatible (preencher as S3_* abaixo)
STORAGE_DRIVER=supabase
STORAGE_BUCKET=catalogo-produtos

# S3_ENDPOINT=https://s3.seudominio.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=seu_access_key
# S3_SECRET_KEY=seu_secret_key
# S3_PUBLIC_URL=https://s3.seudominio.com/catalogo-produtos

# ---------------------------------------------------------------------------
# Bot (Fase 2). Tudo opcional: sem as chaves, a API sobe normalmente e o bot fica desligado.
# ---------------------------------------------------------------------------

# Telegram: crie o bot no @BotFather e cole o token aqui.
TELEGRAM_BOT_TOKEN=
# polling: a API busca as mensagens (desenvolvimento, sem URL pública)
# webhook: o Telegram envia para PUBLIC_API_URL/canais/telegram/webhook (produção)
TELEGRAM_MODE=polling
# PUBLIC_API_URL=https://api.seudominio.com
# TELEGRAM_WEBHOOK_SECRET=gere_um_valor_aleatorio_longo

# IA: provedores (direcao.md, seção 4.1). Basta um deles para o bot funcionar.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_PRIMARY_PROVIDER=groq
AI_ROUTING_MODE=fallback
AI_DAILY_MESSAGE_LIMIT_PER_STORE=300

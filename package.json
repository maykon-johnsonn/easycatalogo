{
  "name": "catalogo",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @catalogo/api dev",
    "dev:web": "pnpm --filter @catalogo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:status": "supabase migration list",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
